[Unit]
Description=3C Review Video Render Worker (:9234)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=administrator
WorkingDirectory=/mnt/f/3c-review-video-studio/video-render
EnvironmentFile=-/mnt/f/3c-review-video-studio/video-render/worker.env
Environment=PORT=9234
ExecStart=/usr/bin/node worker.mjs
# 休眠/网络抖动后进程可能正常退出，需 always 才能自拉起
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
