{
  "name": "3c-video-remotion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "3C 测评短视频 Remotion 渲染内核（与 HyperFrames 并存的另一套渲染引擎，同一套 Timeline JSON）",
  "scripts": {
    "studio": "remotion studio",
