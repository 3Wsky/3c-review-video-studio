{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3c-review-video-studio/schemas/timeline.json",
  "title": "3C Review Timeline",
  "type": "object",
  "required": ["project", "timeline"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["product", "category", "platform", "targetDuration", "layout"],
      "properties": {
        "product": { "type": "string" },
        "category": { "type": "string" },
        "platform": { "type": "string" },
        "targetDuration": { "type": "number", "minimum": 30, "maximum": 240 },
        "layout": { "type": "string", "enum": ["center", "left", "pip", "none"] }
      }
    },
    "insights": {
      "type": "object",
      "properties": {
        "sourceCount": { "type": "number" },
        "summary": { "type": "string" },
        "pros": { "type": "array", "items": { "type": "string" } },
        "cons": { "type": "array", "items": { "type": "string" } },
        "audience": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "start", "end", "voiceover", "visual"],
        "properties": {
          "id": { "type": "string" },
          "index": { "type": "number" },
          "title": { "type": "string" },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "duration": { "type": "number" },
          "voiceover": { "type": "string" },
          "subtitle": { "type": "string" },
          "visual": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "画面类型，自由文本；游戏化特殊值：擂台对决 / 雷达扫描 / 属性觉醒 / 拍摄引导"
              },
              "layout": {
                "type": "string",
                "enum": ["center", "left", "pip", "none", "pip-br", "fullscreen-hud"]
              },
              "headline": { "type": "string" },
              "detail": { "type": "string" },
              "asset": { "type": "string" },
              "cite": { "type": "string" },
              "metric": { "$ref": "#/$defs/metric" },
              "compare": { "$ref": "#/$defs/compare" },
              "radar": { "$ref": "#/$defs/radar" },
              "dataviz": { "$ref": "#/$defs/dataviz" },
              "shootGuide": { "$ref": "#/$defs/shootGuide" },
              "transition": { "$ref": "#/$defs/transition" },
              "broll": { "$ref": "#/$defs/broll" },
              "videoPrompt": {
                "type": "string",
                "maxLength": 500,
                "description": "本镜画面/空镜 AI 生成专用提示词（与口播 voiceover 分离，一键生成时由 LLM 撰写）"
              }
            }
          },
          "checks": { "type": "array", "items": { "type": "string" } },
          "source": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "metric": {
      "title": "单指标数据卡（数字滚动 + 进度环 / 技能树 Stat Ring）",
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": { "type": ["number", "string"] },
        "unit": { "type": "string" },
        "label": { "type": "string" },
        "caption": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "better": { "type": "string", "enum": ["high", "low"] }
      }
    },
    "compare": {
      "title": "横评对比 / 对战擂台 Arena PK（兼容两形：values 多列 或 a/b 双值）",
      "type": "object",
      "required": ["rows"],
      "properties": {
        "style": {
          "type": "string",
          "enum": ["table", "arena"],
          "description": "arena 渲染为擂台 PK 血条对决（亦可由 visual.type 含「擂台/PK」触发）"
        },
        "products": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string" }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "dim": { "type": "string" },
              "unit": { "type": "string" },
              "better": { "type": "string", "enum": ["high", "low"] },
              "values": { "type": "array", "items": { "type": ["number", "string"] } },
              "a": { "type": ["number", "string"] },
              "b": { "type": ["number", "string"] }
            },
            "anyOf": [
              { "required": ["label", "values"] },
              { "required": ["dim", "a", "b"] }
            ]
          }
        }
      }
    },
    "radar": {
      "title": "五维雷达扫描 Sci-Fi HUD",
      "type": "object",
      "required": ["dims"],
      "properties": {
        "dims": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "value": { "type": "number" },
              "max": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    },
    "shootGuide": {
      "title": "拍摄引导 HUD（教用户怎么拍）",
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["product_macro", "hand_hold", "comparison", "talking_head"],
          "description": "拍摄变体，决定取景框示范样式（缺省 product_macro）"
        },
        "title": { "type": "string", "description": "指令主文案，如「拍一张正面特写」" },
        "steps": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 6,
          "description": "checklist 命令式短句，≤12字（兼容旧字段 tips）"
        },
        "tips": {
          "type": "array",
          "items": { "type": "string" },
          "description": "已弃用别名，等价于 steps"
        },
        "angle": { "type": "string", "description": "机位提示，如 45°俯拍·自然光" },
        "safeArea": { "type": "string" },
        "demoAsset": { "type": "string", "description": "左下示范小窗素材路径" },
        "frame": {
          "type": "object",
          "description": "取景框相对坐标（0–1），适配不同分辨率",
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "w": { "type": "number", "minimum": 0, "maximum": 1 },
            "h": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "transition": {
      "title": "镜头转场（Beat 切换动效）",
      "type": "object",
      "properties": {
        "in": {
          "type": "string",
          "enum": ["glitch-cut", "speed-line", "scan-wipe", "pixel-dissolve", "screen-crack", "iris-close"]
        },
        "out": {
          "type": "string",
          "enum": ["glitch-cut", "speed-line", "scan-wipe", "pixel-dissolve", "screen-crack", "iris-close"]
        }
      }
    },
    "broll": {
      "title": "动态空镜穿插（情绪同向，禁无关风景）",
      "type": "object",
      "properties": {
        "source": { "type": "string", "enum": ["pexels", "pixabay", "user", "agnes"] },
        "query": { "type": "string" },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "taskId": { "type": "string", "description": "Agnes 异步任务 ID" },
        "status": {
          "type": "string",
          "enum": ["queued", "running", "completed", "failed", "timeout"]
        },
        "videoUrl": { "type": "string", "format": "uri", "description": "完成后远程 MP4 URL" }
      }
    },
    "dataviz": {
      "title": "数据可视化参数卡（动画条形图 / 雷达图 / 进度环）",
      "type": "object",
      "required": ["kind", "items"],
      "properties": {
        "kind": { "type": "string", "enum": ["bar", "radar", "ring"] },
        "title": { "type": "string" },
        "unit": { "type": "string" },
        "better": { "type": "string", "enum": ["high", "low"] },
        "max": { "type": "number", "exclusiveMinimum": 0 },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "value": { "type": "number" },
              "max": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    }
  }
}
