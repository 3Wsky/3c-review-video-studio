{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3c-review-video-studio/schemas/timeline.json",
  "title": "3C Review Timeline",
  "type": "object",
  "required": ["project", "timeline"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["product", "category", "platform", "targetDuration", "layout"],
      "properties": {
        "product": { "type": "string" },
        "category": { "type": "string" },
        "platform": { "type": "string" },
        "targetDuration": { "type": "number", "minimum": 30, "maximum": 240 },
        "layout": { "type": "string", "enum": ["center", "left", "pip", "none"] }
      }
    },
    "insights": {
      "type": "object",
      "properties": {
        "sourceCount": { "type": "number" },
        "summary": { "type": "string" },
        "pros": { "type": "array", "items": { "type": "string" } },
        "cons": { "type": "array", "items": { "type": "string" } },
        "audience": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "start", "end", "voiceover", "visual"],
        "properties": {
          "id": { "type": "string" },
          "index": { "type": "number" },
          "title": { "type": "string" },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "duration": { "type": "number" },
          "voiceover": { "type": "string" },
          "subtitle": { "type": "string" },
          "visual": { "type": "object" },
          "checks": { "type": "array", "items": { "type": "string" } },
          "source": { "type": "string" }
        }
      }
    }
  }
}
