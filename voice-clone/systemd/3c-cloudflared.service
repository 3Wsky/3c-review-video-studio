[Unit]
Description=Cloudflare Tunnel 3c-worker (render.1go.im + voice.1go.im)
After=network.target 3c-voice-clone.service

[Service]
Type=simple
User=administrator
# QUIC 比 http2 更稳；连接全断时 cloudflared 会以 0 退出，必须 Restart=always
ExecStart=/usr/local/bin/cloudflared tunnel --protocol quic run 3c-worker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
