# 复制为 backend/.env 后填入你的 Key（不要提交到 git）

# === DeepSeek（默认）===
LLM_API_KEY=replace-with-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# === 小米 MiMo（二选一，取消注释并填写）===
# 按量付费：base_url=https://api.xiaomimimo.com/v1，key 以 sk- 开头
# Token Plan 包月：base_url=https://token-plan-cn.xiaomimimo.com/v1，key 以 tp- 开头
# LLM_API_KEY=replace-with-your-mimo-key
# LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# LLM_MODEL=MiMo-V2.5

# === TTS 配音试听（可选，复用上面的 LLM/OPENAI key 与 base_url）===
# 用小米 MiMo-V2.5-TTS（限时免费）。模型与默认音色可覆盖：
# OPENAI_TTS_MODEL=mimo-v2.5-tts
# OPENAI_TTS_VOICE=mimo_default   # 可选：冰糖/茉莉/苏打/白桦/Mia/Chloe...

# === 知乎搜索 API（在 https://developer.zhihu.com/profile 获取 Access Secret）===
# ZHIHU_ACCESS_SECRET=replace-with-your-zhihu-access-secret

# === 克隆音色（可选，自部署 CosyVoice，需 GPU，见 voice-clone/README.md）===
# 填你部署的 CosyVoice 服务公网地址；配置后前端「我的克隆音色」可用
# VOICE_CLONE_URL=https://your-gpu-host:9233

# === 视频渲染 worker（可选，自部署 HyperFrames，需 ffmpeg，见 video-render/README.md）===
# 填你部署的渲染 worker 公网地址；配置后前端「渲染视频」按钮可用
# worker 自己会用上面的 OPENAI/VOICE_CLONE 配置逐镜配音并按真实时长校准
# RENDER_URL=https://your-gpu-host:9234

# === 免费素材源（可选，给「素材库」搜索 + 渲染缺图自动空镜用）===
# 都免费申请、可商用；支持逗号分隔多 key 轮询避免限流。
# Pexels: https://www.pexels.com/api/   Pixabay: https://pixabay.com/api/docs/
# 后端 /api/stock 用这里的 key；渲染 worker 的自动空镜要把同名变量配到 worker 机上。
# PEXELS_API_KEY=key1,key2
# PIXABAY_API_KEY=key1,key2

# === R2 存片 + 分享链接（可选，配在「渲染 worker 机」上，不是后端）===
# 配了这组凭证后，worker 出片会把 MP4 传到 Cloudflare R2，前端拿到可播/下载/分享的 URL；
# 不配则维持「直接下载 MP4」老路（优雅降级）。在 Cloudflare 控制台 R2 → 管理 API 令牌 创建。
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=3c-renders
# 公网播放需要：把 bucket 开 Public 或绑自定义域，把该公开地址填这里（否则返回的是私有 S3 URL）
# R2_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev
# 可选，自定义 S3 endpoint（默认 https://<account>.r2.cloudflarestorage.com）
# R2_ENDPOINT=

# 允许的前端来源，逗号分隔；本地开发可用 *，上线建议填 Cloudflare Pages 域名
# ALLOWED_ORIGINS=https://3c-review-video-studio.pages.dev
ALLOWED_ORIGINS=*
